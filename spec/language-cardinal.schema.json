{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChampuiaSailo/numberwords/spec/language-cardinal.schema.json",
  "title": "numberwords language cardinal slice",
  "description": "Declarative cardinal number↔text data for a bounded integer range (v1 targets 0–100).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "range",
    "sources",
    "lexicon",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Version of this data shape."
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bcp47", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Repository language id (filename stem)."
        },
        "bcp47": {
          "type": "string",
          "minLength": 2,
          "description": "BCP 47 language tag, e.g. lus."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable language name."
        },
        "orthography": {
          "type": "string",
          "description": "Orthography convention for canonical emission."
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "properties": {
            "min": true,
            "max": true
          },
          "description": "max must be >= min (enforced by tooling as well as reviewers)."
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "note": { "type": "string" }
        }
      }
    },
    "lexicon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zero", "units_full", "stems", "scales"],
      "properties": {
        "zero": { "type": "string", "minLength": 1 },
        "units_full": { "$ref": "#/$defs/digitMap" },
        "stems": { "$ref": "#/$defs/digitMap" },
        "scales": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 },
          "propertyNames": { "pattern": "^[1-9][0-9]*$" }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "digitMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1", "2", "3", "4", "5", "6", "7", "8", "9"],
      "properties": {
        "1": { "type": "string", "minLength": 1 },
        "2": { "type": "string", "minLength": 1 },
        "3": { "type": "string", "minLength": 1 },
        "4": { "type": "string", "minLength": 1 },
        "5": { "type": "string", "minLength": 1 },
        "6": { "type": "string", "minLength": 1 },
        "7": { "type": "string", "minLength": 1 },
        "8": { "type": "string", "minLength": 1 },
        "9": { "type": "string", "minLength": 1 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "pattern"],
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 1,
          "description": "Lowest integer this rule covers; greatest base ≤ value wins."
        },
        "pattern": {
          "oneOf": [
            { "$ref": "#/$defs/patternLiteralScale" },
            { "$ref": "#/$defs/patternUnitsFull" },
            { "$ref": "#/$defs/patternScaleFullConcat" },
            { "$ref": "#/$defs/patternScaleStemRemainder" }
          ]
        }
      }
    },
    "patternLiteralScale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scale"],
      "properties": {
        "type": { "const": "literal_scale" },
        "scale": {
          "type": "integer",
          "minimum": 1,
          "description": "Key into lexicon.scales (e.g. 10 → sawm)."
        }
      }
    },
    "patternUnitsFull": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "units_full" }
      }
    },
    "patternScaleFullConcat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scale"],
      "properties": {
        "type": { "const": "scale_full_concat" },
        "scale": { "type": "integer", "minimum": 1 },
        "description": {
          "type": "string",
          "description": "Optional human note (e.g. teens)."
        }
      }
    },
    "patternScaleStemRemainder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scale", "coefficient", "scale_join", "remainder"],
      "properties": {
        "type": { "const": "scale_stem_remainder" },
        "scale": { "type": "integer", "minimum": 1 },
        "coefficient": { "const": "stem" },
        "scale_join": { "const": "concat" },
        "remainder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["form", "separator"],
          "properties": {
            "form": { "const": "units_full" },
            "separator": { "type": "string" }
          }
        }
      }
    }
  }
}
